#------------------------------------------------------------
# CADRC
#
# Source this file before starting any of the tools 
#------------------------------------------------------------
export PRJ="$(pwd)"

#------------------------------------------------------------
# environment variables
#------------------------------------------------------------
export XSCHEMRC="$PRJ/xschemrc"
export TOOLS="$PRJ/tools"
export SCRIPTS="$TOOLS/scripts"
export CORNERS="$TOOLS/corners"
export VENV="$TOOLS/cad"

alias runtest="source $VENV/bin/activate; python3 $SCRIPTS/runtest.py"
